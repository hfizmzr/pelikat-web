FROM node:22-alpine

# libc6-compat needed by some native node addons on Alpine
RUN apk add --no-cache libc6-compat

RUN corepack enable && corepack prepare pnpm@10 --activate

# Set pnpm home directory for caching
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"

WORKDIR /app

# ── Install deps first (cached unless lock file changes) ──────────
COPY package.json pnpm-lock.yaml ./

# Use BuildKit cache mount to persist the pnpm store across builds
RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm install --no-frozen-lockfile

# ── Playwright browsers: NOT installed here.
#    E2E runs on the host (see playwright.config.ts → localhost:3000);
#    browsers in this image would add ~1.3GB of dead weight. ──────────

EXPOSE 3000

CMD ["pnpm", "run", "dev"]