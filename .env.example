# ── Payment provider gate ────────────────────────────────────
# 'mock' = dummy flow (no real charge). 'hitpay' = real HitPay funnel.
NEXT_PUBLIC_PAYMENT_PROVIDER=mock
PAYMENT_PROVIDER=mock

# ── Django BFF funnel ────────────────────────────────────────
DJANGO_URL=http://localhost:8000
INTERNAL_API_KEY=

# ── App URLs (HitPay redirect_url target and links) ──────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_TUNNEL_URL=

# ── Supabase ─────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Web Push (FR-31) ─────────────────────────────────────────
# Public half of the VAPID pair from `node scripts/generate-vapid-keys.mjs`.
# The private half only goes into the dispatch-notifications edge function
# secrets (see supabase/functions/dispatch-notifications/index.ts).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
